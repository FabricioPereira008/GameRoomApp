<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: o banco vai no backup na nuvem e na transferência para um aparelho novo. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
